@startuml 01_Context
!include ../C4_Context.puml

title C4 — Контекст передачи депозитных ставок

Person(operator, "Оператор внутреннего кол-центра", "Консультирует клиентов по депозитным продуктам")

Person(admin, "Сотрудник банка", "Контролирует публикацию ставок и выгрузки")

System_Ext(abs, "АБС / система управления ставками", "Источник утверждённых депозитных ставок")

System_Boundary(bank, "Банк «Стандарт»") {
    System(rates, "Централизованный справочник ставок", "Хранит актуальные и исторические версии опубликованных ставок")
    System(internalCC, "Система внутреннего кол-центра", "Предоставляет операторам доступ к актуальным ставкам")
    System(fileService, "Сервис формирования и передачи файлов", "Формирует CSV/XLSX и передаёт файлы партнёру")
}

System_Ext(partnerCC, "Партнёрский кол-центр", "Получает файлы со ставками. API-вызовы не поддерживаются")

Rel(abs, rates, "Передаёт утверждённые ставки")
Rel(rates, internalCC, "Предоставляет ставки через HTTPS API")
Rel(operator, internalCC, "Просматривает ставки")
Rel(rates, fileService, "Передаёт событие DepositRateUpdated")
Rel(fileService, partnerCC, "Передаёт полный snapshot ставок по SFTP/MFT")
Rel(admin, rates, "Контролирует публикацию")
Rel(admin, fileService, "Контролирует выгрузки и доставку")

@enduml