@startuml 01_context
!include ../C4_Context.puml
title C4 — Контекст MVP цифрового открытия депозитов

Person(newClient, "Новый клиент", "Просматривает продукты и оставляет заявку на сайте; проходит идентификацию в отделении")
Person(existingClient, "Действующий клиент", "Выбирает продукт, счёт и сумму в интернет-банке; подтверждает заявку смс-кодом")
Person(callManager, "Менеджер кол-центра", "Обрабатывает лиды с сайта, связывается с клиентами и предлагает условия")
Person(depositOps, "Сотрудник депозитного бэк-офиса", "Обрабатывает заявки и инициирует согласование условий")
Person(creditOps, "Сотрудник кредитного бэк-офиса", "Использует справочник ставок в пределах назначенных прав")

System_Boundary(bank, "Банк") {
  System(website, "Публичный сайт", "Каталог депозитов и форма заявки нового клиента")
  System(ibank, "Интернет-банк", "Клиентский канал для действующих клиентов")
  System(depositPlatform, "Платформа цифрового открытия депозитов", "Приём и обработка заявок,  смс-подтверждение, справочник ставок, аудит и интеграции")
  System(abs, "АБС", "Согласование ставки и открытие депозита; источник данных по счетам и депозитам")
  System(callcenter, "Система кол-центра / CRM", "Очередь лидов и рабочее место менеджера")
  System(sms, " смс-шлюз", "Доставка OTP и статусных  смс")
}

Rel(newClient, website, "Просматривает продукты, отправляет заявку")
Rel(website, depositPlatform, "Получает каталог; передаёт заявку", "HTTPS")
Rel(existingClient, ibank, "Работает с депозитами")
Rel(ibank, depositPlatform, "Получает каталог, подаёт заявку и читает статусы", "Через адаптер, HTTPS")
Rel(depositPlatform, abs, "Передаёт заявки на согласование/открытие; получает результат", "Асинхронно через интеграционный адаптер")
Rel(depositPlatform, callcenter, "Передаёт лиды новых клиентов", "API/очередь")
Rel(callManager, callcenter, "Обрабатывает лиды")
Rel(depositOps, depositPlatform, "Обрабатывает очередь заявок, управляет условиями")
Rel(creditOps, depositPlatform, "Работает со справочником")
Rel(depositPlatform, sms, "Отправляет OTP и уведомления", "HTTPS/API")
Rel(newClient, callManager, "Общается с менеджером; посещает отделение для идентификации", "Телефон / лично")
Rel(depositOps, abs, "Подтверждает ставку и открывает депозит в действующем процессе")

SHOW_LEGEND()
@enduml
